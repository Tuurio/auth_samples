description: Add secure EU-hosted OIDC authentication with Tuurio ID
globs: "**/*.{ts,tsx,js,jsx,vue,java,kt,kts,py,go,php,swift,dart,json,yaml,yml,xml,plist,properties,toml,gradle,groovy,html}"
alwaysApply: false
